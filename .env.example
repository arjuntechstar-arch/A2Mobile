# Local development. Use a replica set for transactional operations.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=a2local
MONGODB_DATABASE=mobile_shop_scheme
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
PUBLIC_APP_URL=http://localhost:5174
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Payment gateway: Razorpay. Test/live keys must belong to the same account.
# Webhook endpoint: /api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio Messaging Service. Complete regional sender/template onboarding first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Amazon SES SMTP (or another authenticated STARTTLS SMTP service).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# KYC only: Cashfree Secure ID credentials, with the server IP allowlisted.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox

# Service account path is private; client options contain only public Firebase config.
FIREBASE_CREDENTIALS=
FIREBASE_CLIENT_OPTIONS={}
FIREBASE_WEB_VAPID_KEY=

DATA_ENCRYPTION_KEYS=
# Keep prior encryption keys after the active key, comma-separated, during rotation.

APP_ENVIRONMENT=development
LOCAL_SKIP_KYC=false
